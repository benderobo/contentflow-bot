# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://yourdomain.com

# Database
DATABASE_URL=postgresql://contentflow:contentflow@postgres:5432/contentflow
SQLALCHEMY_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# AI Providers
AI_PROVIDER=openrouter  # openrouter, openai, anthropic, ollama
AI_MODEL=openrouter/auto
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Security
SECRET_KEY=your-secret-key-for-jwt
ADMIN_TELEGRAM_IDS=123456789,987654321
WEBHOOK_SECRET=your-webhook-secret

# Timezone
TIMEZONE=Europe/Zurich

# Environment
DEBUG=false
LOG_LEVEL=INFO

# Rate Limiting
TELEGRAM_RATE_LIMIT=30  # requests per second
PARSER_RATE_LIMIT=10    # concurrent parsers

# Storage
MAX_FILE_SIZE=52428800  # 50MB
MEDIA_STORAGE_PATH=/app/storage/media

# Features
AUTO_PUBLISH_ENABLED=false
ENABLE_REWRITE=true
ENABLE_ANALYTICS=true
